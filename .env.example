OPENAI_API_KEY=your_openai_key_here
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here
META_ACCESS_TOKEN=your_meta_token_here
META_PAGE_ID=your_facebook_page_id_here
META_INSTAGRAM_ACCOUNT_ID=your_instagram_id_here

# Optional settings (defaults shown)
# META_GRAPH_VERSION=v23.0
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY   # unaudited TikTok apps may only post privately
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=standard     # or "hd" (about double the cost)

# Image hosting (used by src/uploader.py). MEDIA_HOST is "imgur" or "r2".
MEDIA_HOST=imgur
IMGUR_CLIENT_ID=your_imgur_client_id_here
# Cloudflare R2 (needed for TikTok, which only pulls media from a domain you own)
# R2_ACCOUNT_ID=your_r2_account_id_here
# R2_ACCESS_KEY_ID=your_r2_access_key_here
# R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
# R2_BUCKET=your_bucket_name_here
# R2_PUBLIC_URL=https://media.yourdomain.com
# JPEG_QUALITY=90

# Encryption key for tokens entered on the dashboard Settings page.
# Generate with: python3 -m src.main keygen
APP_SECRET_KEY=your_app_secret_key_here

# Video posts (TikTok / Reels). Speech provider: openai or elevenlabs.
TTS_PROVIDER=openai
# TTS_FALLBACK=elevenlabs           # tried when the primary is out of quota
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=nova
# CAPTION_SYNC=estimate             # or "whisper" for real word timestamps (one extra API call)
# CAPTION_WORDS=3                   # words per caption chunk
# MUSIC_GAIN_DB=-18                 # background music level (put tracks in data/bg_music/)
# VIDEO_FONT=/path/to/Bold.ttf      # caption font, auto-detected on Linux/macOS/Windows

# Multi-user dashboard
# JWT_SECRET=                        # session signing secret (falls back to APP_SECRET_KEY)
# JWT_EXPIRE_MINUTES=10080           # 7 days
# COOKIE_SECURE=1                    # set when served over HTTPS
# MAX_UPLOAD_MB=500
# DATABASE_URL=postgresql://social:password@localhost:5432/social   # omit for SQLite

# Stripe billing (optional; plans can also be set with the operator CLI)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# AI providers. Gemini has a free tier for text and photo/video understanding;
# Cloudflare Workers AI has a small free daily allowance for image generation.
# Each is optional: the tool uses whichever keys exist (or set them per user on the dashboard).
# GEMINI_API_KEY=your_gemini_key_here          # https://aistudio.google.com/apikey
# CF_API_TOKEN=your_cloudflare_token_here      # Workers AI permission; uses R2_ACCOUNT_ID
# TEXT_PROVIDER=gemini      # force: gemini | openai
# VISION_PROVIDER=gemini    # force: gemini | openai
# IMAGE_PROVIDER=cloudflare # force: cloudflare | gemini | openai
