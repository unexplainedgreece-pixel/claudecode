OPENAI_API_KEY=your_openai_key_here
TIKTOK_ACCESS_TOKEN=your_tiktok_token_here
META_ACCESS_TOKEN=your_meta_token_here
META_PAGE_ID=your_facebook_page_id_here
META_INSTAGRAM_ACCOUNT_ID=your_instagram_id_here

# Optional settings (defaults shown)
# META_GRAPH_VERSION=v23.0
# TIKTOK_PRIVACY_LEVEL=SELF_ONLY   # unaudited TikTok apps may only post privately
# OPENAI_IMAGE_MODEL=dall-e-3
# OPENAI_IMAGE_SIZE=1024x1024
# OPENAI_IMAGE_QUALITY=standard     # or "hd" (about double the cost)

# Image hosting (used by src/uploader.py). MEDIA_HOST is "imgur" or "r2".
MEDIA_HOST=imgur
IMGUR_CLIENT_ID=your_imgur_client_id_here
# Cloudflare R2 (needed for TikTok, which only pulls media from a domain you own)
# R2_ACCOUNT_ID=your_r2_account_id_here
# R2_ACCESS_KEY_ID=your_r2_access_key_here
# R2_SECRET_ACCESS_KEY=your_r2_secret_key_here
# R2_BUCKET=your_bucket_name_here
# R2_PUBLIC_URL=https://media.yourdomain.com
# JPEG_QUALITY=90

# Encryption key for tokens entered on the dashboard Settings page.
# Generate with: python3 -m src.main keygen
APP_SECRET_KEY=your_app_secret_key_here
